# Site blocks for MoniShield's Caddy ("https" profile). Append them to MoniShield's deploy/Caddyfile.letsencrypt
# and COMMIT them in the MoniShield repo: MoniShield's deploy runs `git reset --hard`, which would drop an edit
# made only on the server. DNS for apisdsn.com and www.apisdsn.com must point to the server.
#
# portfolio-api / portfolio-web are network aliases the portfolio containers register on monishield_default.

apisdsn.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# Revalidation is only called from inside Docker (api -> web)
	handle /internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy portfolio-api:8080
	}

	handle {
		reverse_proxy portfolio-web:3000
	}
}

www.apisdsn.com {
	redir https://apisdsn.com{uri} permanent
}
