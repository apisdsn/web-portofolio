# Copy to /srv/web-portofolio/.env on the server and fill in. Never commit the real file.

# Public domain for the portfolio. Its DNS A record must point to the server,
# and the same domain must be in MoniShield's Caddyfile (deploy/Caddyfile.portfolio).
PORTFOLIO_DOMAIN=portfolio.example.com

# Separate database + role inside MoniShield's PostgreSQL (created automatically by remote-deploy.sh)
PORTFOLIO_DB_NAME=portfolio
PORTFOLIO_DB_USER=portfolio
PORTFOLIO_DB_PASSWORD=

# Admin account, created on first start (password: at least 12 characters)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Generate each with: openssl rand -base64 48
JWT_SECRET=
REVALIDATE_SECRET=

BACKUP_RETENTION_DAYS=7

# Only if MoniShield's compose network has another name than monishield_default
# MONISHIELD_NETWORK=monishield_default
